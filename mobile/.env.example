# ---------------------------------------------------------------------------
# Mobile environment variables — copy to mobile/.env and fill in.
# Only EXPO_PUBLIC_* vars are inlined into the client bundle and are visible
# to end users, so never put real secrets here.
# ---------------------------------------------------------------------------
# Backend API base URL. Use your LAN IP when testing on a physical device,
# e.g. http://192.168.1.10:8000 — localhost won't work from a phone.
EXPO_PUBLIC_API_URL=https://financial-enrich-last.ngrok-free.dev/api

# ---------------------------------------------------------------------------
# Backend environment variables — copy this file to backend/.env
# then fill in REAL values (get them from the project owner privately).
# NEVER commit the actual .env file — it contains live secrets.
# ---------------------------------------------------------------------------

# Django core
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-random-50-char-key

# DEBUG must be False for any deployment.
# To run locally with DEBUG=True you also need ALLOW_DEV=True (safety guard).
DEBUG=True
ALLOW_DEV=True

# Add your ngrok subdomain here once you have it (see Collaborator Setup Guide in README)
# Example: localhost,127.0.0.1,0.0.0.0,abcd-1234-efgh.ngrok-free.app,.ngrok-free.app,*
ALLOWED_HOSTS=localhost,127.0.0.1,financial-enrich-last.ngrok-free.dev,.ngrok-free.dev,192.168.0.159,172.20.10.3

# Security hardening — leave False for local http; set True when behind TLS in production.
SECURE_HTTP=False

# ---------------------------------------------------------------------------
# PostgreSQL — create the DB and user first (see README Part A)
# ---------------------------------------------------------------------------
POSTGRES_DB=reusehub
POSTGRES_USER=reusehub
POSTGRES_PASSWORD=change-me-choose-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# CORS — for local dev you can set CORS_ALLOW_ALL_ORIGINS=True.
# In production set it to False and list exact origins in CORS_ALLOWED_ORIGINS.
# ---------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# JWT (SimpleJWT)
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Rate limiting (DRF) — optional overrides; defaults applied if omitted.
# ---------------------------------------------------------------------------
THROTTLE_ANON_RATE=30/min
THROTTLE_USER_RATE=120/min
THROTTLE_AUTH_LOGIN_RATE=10/min
THROTTLE_PAYMENT_INITIATE_RATE=15/min

# ---------------------------------------------------------------------------
# ClickPesa Payment Gateway
# See CLICKPESA_PAYMENT_ARCHITECTURE.md for full explanation.
# ---------------------------------------------------------------------------
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

# From ClickPesa Dashboard → Developers → App credentials
CLICKPESA_CLIENT_ID=get-from-project-owner
CLICKPESA_API_KEY=get-from-project-owner

# The CHK... checksum key from ClickPesa Dashboard → Developers → Checksum
# CLICKPESA_CHECKSUM_SECRET and CLICKPESA_WEBHOOK_SECRET are the SAME value.
CLICKPESA_CHECKSUM_SECRET=get-from-project-owner
CLICKPESA_WEBHOOK_SECRET=get-from-project-owner

# Currency (USSD-PUSH accepts TZS only — do not change)
CLICKPESA_CURRENCY=TZS

# HTTP timeout (seconds) for outbound ClickPesa calls (USSD-push initiation,
# status queries). Increase if mobile-money gateway responses are slow.
CLICKPESA_TIMEOUT=45

# Auto-payout on withdrawal completion (ClickPesa PAYOUT API).
# Keep False unless the merchant has PAYOUT API access + real balance.
CLICKPESA_PAYOUTS_ENABLED=False

# ---------------------------------------------------------------------------
# ngrok — updated with current tunnel URL
# ---------------------------------------------------------------------------
NGROK_PUBLIC_URL=https://financial-enrich-last.ngrok-free.dev
CLICKPESA_WEBHOOK_BASE_URL=https://financial-enrich-last.ngrok-free.dev

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
TIME_ZONE=Africa/Dar_es_Salaam

# ---------------------------------------------------------------------------
# Render deployment environment variables — reference ONLY.
#
# These are NOT read from a file on Render (there is no .env on the server).
# Instead, set them in the Render dashboard:
#   Dashboard → reusehub-backend → Environment
#   (or define them in the render.yaml blueprint at the repo root).
#
# Copy the values below as a checklist. NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# Core Django — same as local, but DEBUG must be False.
DJANGO_SECRET_KEY=long-random-50-char-string   # auto-generated if you use render.yaml
DEBUG=False
ALLOW_DEV=False
DJANGO_SETTINGS_MODULE=config.settings

# --- Database ---------------------------------------------------------------
# The project now defaults to SQLite (USE_SQLITE=True) so it runs on Render's
# free tier with no external database service. On Render, point the DB at the
# persistent disk so data survives redeploys:
USE_SQLITE=True
SQLITE_DB_PATH=/opt/render/project/src/data/db.sqlite3

# (Optional) To use PostgreSQL instead, set USE_SQLITE=False and provide the
# POSTGRES_* variables (or a Render managed Postgres).
POSTGRES_DB=reusehub
POSTGRES_USER=reusehub
POSTGRES_PASSWORD=strong-password
POSTGRES_HOST=your-render-db-host
POSTGRES_PORT=5432

# ClickPesa — same credentials as local. Set WEBHOOK_BASE_URL / NGROK_PUBLIC_URL
# to your Render service HTTPS URL so ClickPesa can call back:
#   https://reusehub-backend.onrender.com/api/clickpesa/webhook/
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=your-client-id
CLICKPESA_API_KEY=your-api-key
CLICKPESA_CHECKSUM_SECRET=your-chk-secret
CLICKPESA_WEBHOOK_SECRET=your-webhook-secret
CLICKPESA_CURRENCY=TZS
CLICKPESA_TIMEOUT=45
CLICKPESA_PAYOUTS_ENABLED=False

# Public URL for webhooks (must be your Render service, NOT an old ngrok URL).
CLICKPESA_WEBHOOK_BASE_URL=https://reusehub-backend.onrender.com
NGROK_PUBLIC_URL=https://reusehub-backend.onrender.com

# Misc
TIME_ZONE=Africa/Dar_es_Salaam

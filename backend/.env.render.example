# ---------------------------------------------------------------------------
# Render deployment environment variables — reference ONLY.
#
# These are NOT read from a file on Render (there is no .env on the server).
# Instead, set them in the Render dashboard:
#   Dashboard → reusehub-backend → Environment
#   (or define them in the render.yaml blueprint at the repo root).
#
# Copy the values below as a checklist. NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

# Core Django — same as local, but DEBUG must be False.
DJANGO_SECRET_KEY=long-random-50-char-string   # auto-generated if you use render.yaml
DEBUG=False
ALLOW_DEV=False
DJANGO_SETTINGS_MODULE=config.settings

# Hosts that may reach the API. On Render add your service hostname, e.g.:
#   reusehub-backend.onrender.com
# Render also auto-appends RENDER_EXTERNAL_HOSTNAME, so leaving this at your
# service URL (or a placeholder) is fine. No wildcard in production.
ALLOWED_HOSTS=reusehub-backend.onrender.com

# Render terminates TLS and sets X-Forwarded-Proto: https -> enables SSL
# redirect, HSTS and secure cookies.
SECURE_HTTP=True

# CORS — the origins that may call this API from a browser (Expo/web build).
# Keep CORS_ALLOW_ALL_ORIGINS=False and list exact origins.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-app.expo.dev

# Database — Render's managed PostgreSQL. If you created the DB via the
# render.yaml blueprint, DATABASE_URL is injected automatically:
#   postgres://user:password@host:port/dbname
# If you set up the DB manually, either set DATABASE_URL, or set the individual
# POSTGRES_* values below.
DATABASE_URL=postgres://user:password@host:port/reusehub
# (fallback individual vars, only when DATABASE_URL is not set)
POSTGRES_DB=reusehub
POSTGRES_USER=reusehub
POSTGRES_PASSWORD=strong-password
POSTGRES_HOST=your-render-db-host
POSTGRES_PORT=5432

# Uploaded media — points at the Render persistent disk (mounted at
# /opt/render/project/src/media). Only needed if you set a disk mount that is
# not the default media/ path.
MEDIA_ROOT=/opt/render/project/src/media

# ClickPesa — same credentials as local. Set WEBHOOK_BASE_URL / NGROK_PUBLIC_URL
# to your Render service HTTPS URL so ClickPesa can call back:
#   https://reusehub-backend.onrender.com/api/clickpesa/webhook/
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=your-client-id
CLICKPESA_API_KEY=your-api-key
CLICKPESA_CHECKSUM_SECRET=your-chk-secret
CLICKPESA_WEBHOOK_SECRET=your-webhook-secret
CLICKPESA_CURRENCY=TZS
CLICKPESA_TIMEOUT=45
CLICKPESA_PAYOUTS_ENABLED=False

# Public URL for webhooks (must be your Render service, NOT an old ngrok URL).
CLICKPESA_WEBHOOK_BASE_URL=https://reusehub-backend.onrender.com
NGROK_PUBLIC_URL=https://reusehub-backend.onrender.com

# Misc
TIME_ZONE=Africa/Dar_es_Salaam
